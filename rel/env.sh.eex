#!/bin/sh

# Load code on demand instead of preloading everything at boot.
#
# A release defaults to RELEASE_MODE=embedded, where the VM refuses to load any
# module that was not in the boot script. Plugins are compiled separately and
# loaded at runtime from the plugins directory, so under the default every one
# of them fails with `{:error, :embedded}` — server scripting works under
# `mix phx.server` and is silently dead in the artifact that actually ships.
#
# The startup banner still says "Plugins: N loaded", because the manager counts
# what it found on disk rather than what the VM accepted; the failures are only
# visible as error lines above it.
export RELEASE_MODE=interactive
